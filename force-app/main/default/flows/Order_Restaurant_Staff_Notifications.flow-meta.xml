            </conditions>
            <connector>
                <targetReference>Loop_Staff_For_Email</targetReference>
            </connector>
            <label>Staff Email Users Exist</label>
        </rules>
    </decisions>
    <description>Sends restaurant staff an in-app notification when a new Order is created (Status moves to Pending for the first time), and an email notification when an Order status changes to Preparing. Uses Profile.Name = Restaurant Staff to identify recipients.</description>
    <interviewLabel>Order Restaurant Staff Notifications {!$Flow.CurrentDateTime}</interviewLabel>
    <label>Order - Restaurant Staff Notifications</label>
    <loops>

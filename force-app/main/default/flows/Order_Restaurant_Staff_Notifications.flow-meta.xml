    <decisions>
        <name>Route_By_Event</name>
        <label>Route by Event</label>
        <locationX>176</locationX>
        <locationY>168</locationY>
        <defaultConnectorLabel>No Staff Notification Needed</defaultConnectorLabel>
        <rules>
            <name>Is_New_Order</name>
            <conditionLogic>and</conditionLogic>
            <conditions>
                <leftValueReference>$Record__Prior.Status__c</leftValueReference>
                <operator>IsNull</operator>
                <rightValue>
                    <booleanValue>true</booleanValue>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>Get_Notification_Type</targetReference>
            </connector>
            <label>New Order Created</label>
        </rules>
        <rules>
            <name>Is_Now_Preparing</name>
            <conditionLogic>and</conditionLogic>
            <conditions>
                <leftValueReference>$Record.Status__c</leftValueReference>
                <operator>EqualTo</operator>
                <rightValue>
                    <stringValue>Preparing</stringValue>
                </rightValue>
            </conditions>
            <conditions>
                <leftValueReference>$Record__Prior.Status__c</leftValueReference>
                <operator>NotEqualTo</operator>
                <rightValue>
                    <stringValue>Preparing</stringValue>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>Get_Staff_For_Email</targetReference>
            </connector>
            <label>Now Preparing</label>
        </rules>
    </decisions>
    <decisions>
